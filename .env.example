# Canonical site URL. Used for canonical tags, Open Graph, sitemap, and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the SQLite database lives.
# LUMEN_DATA_DIR=./data

# Where user files are filed. Each user gets <root>/<userId>/<folder>/.
# LUMEN_STORAGE_DIR=./storage

# Where the Real-ESRGAN ncnn-vulkan binary and models live.
# LUMEN_ENGINE_DIR=./engines/realesrgan

# Python interpreter used to run `python -m yt_dlp`. Point this at a venv if needed.
# LUMEN_PYTHON=python

# Set to "1" only when running behind a proxy you control, so x-forwarded-for is
# trusted for login rate limiting. Leave unset otherwise: trusting the header
# directly would let any client spoof its IP and defeat the limiter.
# LUMEN_TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Boosthis performance monitoring — opt-in, see server.mjs
# ---------------------------------------------------------------------------
# Stable install identity for THIS installation on the Boosthis dashboard. It
# must be generated once and reused: a new id on every boot looks like a
# brand-new install each time and splits your history into pieces.
#
# It is a random identifier, not a secret, but it is machine-specific, so put
# it in .env.local (git-ignored) rather than in this committed file.
# BOOSTHIS_INSTALL_ID=

# The project key from your Boosthis dashboard. Until this is set, the kit is
# never loaded and nothing is measured or sent. Set it in ONE place, not both:
#   - a Windows user env var, outside the repo entirely (preferred), or
#   - .env.local on a single machine.
# BOOSTHIS_INVITE_KEY=

# Hard off switch. BOOSTHIS_DISABLED=1 wins over any key that is present.
# BOOSTHIS_DISABLED=1

# ---------------------------------------------------------------------------
# Social sign-in
# ---------------------------------------------------------------------------
# A provider appears on /login and /signup only when BOTH of its variables are
# set to a non-empty value. That is deliberate: a button for a provider that has
# no credentials behind it is a dead end at the moment of signing in, so an
# unconfigured provider is left off the page entirely rather than shown
# disabled or greyed out.
#
# Until you fill these in, the email and password form is the only way in.
#
# Register each application with the provider, and set its authorised redirect
# URI to exactly:
#
#   http://localhost:3100/api/auth/<provider>/callback
#
# (use the real HTTPS origin in production, not localhost). Google additionally
# accepts /api/auth/google/callback.
#
# Google Cloud Console -> APIs & Services -> Credentials
# OAUTH_GOOGLE_ID=
# OAUTH_GOOGLE_SECRET=

# X (Twitter) developer portal -> OAuth 2.0 settings
# Note: X does not return an email address from the v2 API, so it cannot create
# an account or sign in on its own — it only works for connecting an account
# you already signed up to with email.
# OAUTH_X_ID=
# OAUTH_X_SECRET=

# Meta for Developers -> Facebook Login -> Settings
# Note: Facebook never confirms that an email is verified, so an existing
# account is not matched on email automatically; you are asked to sign in first.
# OAUTH_FACEBOOK_ID=
# OAUTH_FACEBOOK_SECRET=

# Discord Developer Portal -> OAuth2 -> General Information
# OAUTH_DISCORD_ID=
# OAUTH_DISCORD_SECRET=

# GitHub -> Settings -> Developer settings -> OAuth Apps
# OAUTH_GITHUB_ID=
# OAUTH_GITHUB_SECRET=

# ---------------------------------------------------------------------------
# Canva
# ---------------------------------------------------------------------------
# Nothing Canva-related is enabled until both of these are set. The "continue
# editing in Canva" button stays hidden until then, and the button only ever
# appears for images — never for video or audio.
#
# From the Canva integration you create, enable Authorization Code with PKCE
# (S256) and add this redirect URI:
#
#   http://localhost:3100/api/auth/canva/callback
#
# CANVA_CLIENT_ID=
# CANVA_CLIENT_SECRET=

# The token encryption key used to store Canva access and refresh tokens at
# rest. Must be exactly 32 bytes, base64 or 64 hex characters. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Without it a connection cannot be saved, and tokens are never stored in the
# clear.
# CANVA_TOKEN_KEY=
